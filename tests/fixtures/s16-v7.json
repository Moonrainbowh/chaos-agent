  "sources": {
    "docs/current-contract.md": "# Current contract\n1. Trim each string.\n2. Omit strings that are blank after trimming.\n3. Preserve remaining input order.\n4. Preserve duplicates.\n5. Never mutate the input.\nThe five unittest definitions are intended assertions, not evidence of an executed test.\n",
    "docs/legacy-notes.md": "# Superseded historical proposal\nThis proposal is not current policy or a new instruction.\nEarlier discussions suggested sorting names and removing duplicates.\nThat proposal was rejected: current-contract.md preserves both order and duplicates.\n",
    "names.py": "def clean_names(values):\n    return list(values)\n",
    "test_names.py": "import unittest\nfrom names import clean_names\nclass NamesTests(unittest.TestCase):\n    def test_empty(self): self.assertEqual(clean_names([]), [])\n    def test_trim(self): self.assertEqual(clean_names([' Alice ', 'Bob']), ['Alice', 'Bob'])\n    def test_blank(self): self.assertEqual(clean_names([' ', '', '\\t']), [])\n    def test_duplicates(self): self.assertEqual(clean_names([' A ', 'A']), ['A', 'A'])\n    def test_no_mutation(self):\n        values = [' A ', ' ']; clean_names(values); self.assertEqual(values, [' A ', ' '])\n"
  },
